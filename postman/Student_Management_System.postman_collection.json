{
  "info": {
    "name": "Student Management System - Khorn Sokhadom",
    "description": "All requests go through the API Gateway (Kubernetes NodePort service `student-gateway-service`).\n\nBefore running: `kubectl port-forward service/student-gateway-service 9090:8080` (or set `base_url` to the URL printed by `minikube service student-gateway-service --url`).\n\nRun the requests top to bottom: Register saves the new Student_id into the `student_id` variable, and the Update requests use it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:9090" },
    { "key": "student_id", "value": "1" }
  ],
  "item": [
    {
      "name": "0. API Gateway",
      "item": [
        {
          "name": "Gateway - Routes",
          "request": { "method": "GET", "url": "{{base_url}}/" }
        },
        {
          "name": "Gateway - Health",
          "request": { "method": "GET", "url": "{{base_url}}/health" }
        }
      ]
    },
    {
      "name": "1. Registration Microservice (Pod 1)",
      "item": [
        {
          "name": "Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Student registered (201)', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.student && body.student.Student_id) {",
                  "  pm.collectionVariables.set('student_id', body.student.Student_id);",
                  "  console.log('Saved student_id =', body.student.Student_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_name\": \"Khorn Sokhadom\",\n  \"student_mobile\": \"012345678\",\n  \"student_email\": \"sokhadom{{$randomInt}}@student.edu\",\n  \"student_password\": \"pass1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/register"
          }
        },
        {
          "name": "Get All Students",
          "request": { "method": "GET", "url": "{{base_url}}/api/students" }
        },
        {
          "name": "Get Student By Id",
          "request": { "method": "GET", "url": "{{base_url}}/api/students/{{student_id}}" }
        }
      ]
    },
    {
      "name": "2. Update Microservice (Pod 2)",
      "item": [
        {
          "name": "Update Mobile Number",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Mobile updated (200)', () => pm.response.to.have.status(200));"] } }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_mobile\": \"098765432\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/update/mobile/{{student_id}}"
          }
        },
        {
          "name": "Update Password",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Password updated (200)', () => pm.response.to.have.status(200));"] } }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_password\": \"newpass5678\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/update/password/{{student_id}}"
          }
        },
        {
          "name": "Update Mobile and Password Together",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student updated (200)', () => pm.response.to.have.status(200));"] } }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_mobile\": \"011223344\",\n  \"student_password\": \"finalpass999\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/update/{{student_id}}"
          }
        },
        {
          "name": "Verify Update (Get Student By Id)",
          "request": { "method": "GET", "url": "{{base_url}}/api/students/{{student_id}}" }
        },
        {
          "name": "Update Unknown Student (404 example)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_mobile\": \"099999999\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/update/mobile/99999"
          }
        }
      ]
    }
  ]
}
